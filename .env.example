# MediKiosk Backend — Environment Configuration
# Copy this file to .env and fill in values for your deployment topology.

# ==============================================================================
# 1. DEPLOYMENT TOPOLOGY
# ==============================================================================
# Options:
#   STANDALONE : All services run locally on this machine (Ollama + local TTS/OCR)
#   CLUSTER    : Thin-client kiosk node forwarding heavy GPU compute to On-Premise Edge Server
#   CLOUD      : Cloud-accelerated (Gemini Flash + Groq + Sarvam AI)
DEPLOYMENT_MODE=STANDALONE

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === Database ===
DATABASE_PATH=./medikiosk.db

# ==============================================================================
# 2. ON-PREMISE EDGE GPU SERVER (Ollama & Speech Microservices)
# ==============================================================================
# For STANDALONE: http://localhost:11434/v1
# For CLUSTER (Remote Edge Node LAN / Subnet): http://192.168.137.45:11434/v1 or Tailscale IP
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# Optional: Dedicated Speech Microservice on On-Premise Edge Node (IndicF5 TTS + IndicConformer ASR)
# Leave empty to use cloud Sarvam AI only (offline speech is unavailable without this).
# For CLUSTER: http://192.168.137.45:8001
SPEECH_SERVICE_URL=

# Model paths for local edge inference
INDICCONFORMER_MODEL_PATH=./models/indicconformer
INDICF5_MODEL_PATH=ai4bharat/IndicF5
CONCEPT_BANK_PATH=./app/data/concept_bank.json

# ==============================================================================
# 2B. SEMANTIC CONCEPT NORMALIZER (Multilingual CPU Embeddings)
# ==============================================================================
# Maps patient statements to SNOMED-CT / NAMASTE codes via cosine similarity.
# MUST be a multilingual model — patient input arrives in Devanagari (hi/mr),
# Tamil, Telugu and Latin script. all-MiniLM-L6-v2 is English-only and emits
# [UNK] tokens for Indic scripts, so it must never be used here.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Pre-compute concept embeddings during app startup (~470 MB model download on
# first run). Set to false to defer loading to the first request instead.
EMBEDDING_WARMUP_ON_STARTUP=true

# ==============================================================================
# 3. CLOUD ACCELERATION TIERS (Free Tiers for Hackathon Demo)
# ==============================================================================
# Google Gemini (Primary Vision & Multimodal Clinical Reasoning - 1500 req/day free)
GEMINI_API_KEY=

# Groq Cloud (Sub-500ms Llama-3.1-70B fast fallback - 14,400 req/day free)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Sarvam AI (High-fidelity Indian Voice & Speech - ₹100 free credit)
SARVAM_API_KEY=

# ==============================================================================
# 4. SECURITY & AUDIT
# ==============================================================================
DOCTOR_PIN=1234
AUDIO_PURGE_AFTER_SECONDS=300
