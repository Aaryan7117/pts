# MediKiosk Backend — Environment Variables
# Copy this to .env and fill in your values

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === Database ===
DATABASE_PATH=./medikiosk.db

# === Ollama (Local Edge LLM — runs on the 8GB VRAM laptop) ===
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# === Groq (Cloud Speed LLM — optional) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# === Google Gemini (Cloud Quality LLM — optional) ===
GEMINI_API_KEY=

# === Sarvam AI (Cloud ASR — optional) ===
SARVAM_API_KEY=

# === Model Paths (for friend's laptop) ===
INDICWHISPER_MODEL_PATH=./models/indicwhisper
PIPER_VOICE_MODEL_PATH=./models/piper/hi_IN-rohan-medium.onnx
CONCEPT_BANK_PATH=./app/data/concept_bank.json

# === Security ===
DOCTOR_PIN=1234
AUDIO_PURGE_AFTER_SECONDS=300
